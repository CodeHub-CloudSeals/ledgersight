{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LedgerSight (local)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ledgersight.app:app", "--host", "127.0.0.1", "--port", "8090", "--workers", "1"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "AVOCET_SECURE_COOKIE": "0",
        "AVOCET_CLIENTS": "client-a",
        "AVOCET_REQUIRE_MFA": "0",
        "AVOCET_NO_LOGIN": "1",
        "AVOCET_SHOW_SAMPLES": "0",
        "AVOCET_BOOTSTRAP_USER": "presenter",
        "AVOCET_BOOTSTRAP_NAME": "Administrator",
        "AVOCET_REGION_DECLARED": "this computer (local)",
        "AVOCET_DATA_DIR": "${workspaceFolder}/.ledgersight-data"
      }
    },
    {
      "name": "LedgerSight tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
