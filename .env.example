# Copy this file to .env and fill in your own values. .env is ignored by git.
# Administrator account created at start-up (used when login is switched on).
AVOCET_BOOTSTRAP_PASSWORD=choose-a-long-password-here
# Base32 authenticator secret for that account. Generate one with:
#   python -c "from ledgersight.auth import totp_secret; print(totp_secret())"
AVOCET_BOOTSTRAP_TOTP=REPLACE_WITH_A_BASE32_SECRET
# Optional: Google Drive / Sheets / Docs / Slides import (read-only, drive.file scope: only files the user picks).
# From Google Cloud Console: an OAuth 2.0 Web client whose authorised JavaScript origins include this app's URL
# (http://127.0.0.1:8090 locally, the HTTPS Cloud Run URL when hosted), and an API key with the Google Picker API
# and Google Drive API enabled. Leave empty to hide Drive (the Connect button then shows these setup steps).
# GOOGLE_CLIENT_ID=
# GOOGLE_API_KEY=
# GOOGLE_APP_ID=
# Optional: role given to someone the first time they sign in with Google.
# preparer (default, least privilege) or owner_reviewer (CPA reviewer: can approve/reject review items).
# AVOCET_GOOGLE_DEFAULT_ROLE=preparer
# Optional: signing key from your secret store (PEM). Without it a key file is kept in the data folder.
# AVOCET_SIGNING_KEY_PEM=
