# Never upload local secrets, environments or data to Cloud Build
.git/
.gitignore
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ledgersight-data/
.avocet-data/
*.pem
.vscode/
.DS_Store
# any local data folder (database with password hashes, TOTP secrets, uploads)
.ledgersight-data*/
*.db
*.db-wal
*.db-shm
